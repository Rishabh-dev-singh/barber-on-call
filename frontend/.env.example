# ==============================================================================
# Barber On Call - Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust VITE_API_BASE_URL as needed.

# Local browser development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Android emulator:
# VITE_API_BASE_URL=http://10.0.2.2:8000

# Real Android device on local network (replace with your machine's IP):
# VITE_API_BASE_URL=http://192.168.1.100:8000

# Production API URL:
# VITE_API_BASE_URL=https://api.yourdomain.com

# Razorpay Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
